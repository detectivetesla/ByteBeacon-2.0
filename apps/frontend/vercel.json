{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/og/:slug",
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/api/storefront-og/:slug",
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/favicon.ico",
      "has": [
        {
          "type": "host",
          "value": "(?i).*apisolutions\\.store"
        }
      ],
      "destination": "/storefront-icon.png"
    },
    {
      "source": "/favicon.png",
      "has": [
        {
          "type": "host",
          "value": "(?i).*apisolutions\\.store"
        }
      ],
      "destination": "/storefront-icon.png"
    },
    {
      "source": "/logo.png",
      "has": [
        {
          "type": "host",
          "value": "(?i).*apisolutions\\.store"
        }
      ],
      "destination": "/storefront-icon.png"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?i).*apisolutions\\.store"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|telegrambot|slackbot|discordbot|applebot|linkedinbot|pinterest|googlebot|bingbot|baiduspider|yandexbot|duckduckbot).*"
        }
      ],
      "destination": "/api/storefront"
    },
    {
      "source": "/store/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|telegrambot|slackbot|discordbot|applebot|linkedinbot|pinterest|googlebot|bingbot|baiduspider|yandexbot|duckduckbot).*"
        }
      ],
      "destination": "/api/storefront?slug=:slug"
    },
    {
      "source": "/:slug((?!api|assets|favicon|logo|manifest|site|storefront-icon|app|agent|admin|signin|signup|forgot-password|reset-password|verify-email|mfa|buy|track|info|docs|developer|portal|store|unauthorized|buy-data|bundles).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|telegrambot|slackbot|discordbot|applebot|linkedinbot|pinterest|googlebot|bingbot|baiduspider|yandexbot|duckduckbot).*"
        }
      ],
      "destination": "/api/storefront?slug=:slug"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?i).*apisolutions\\.store"
        }
      ],
      "destination": "/apisolutions.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
