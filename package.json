{
  "name": "bytebeacon",
  "displayName": "ByteBeacon (ByteBeacon 2.0)",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "description": "ByteBeacon 2.0 Monorepo Foundation — Production Brand: ByteBeacon",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build -w @bytebeacon/shared && npm run build -w @bytebeacon/frontend && npm run build -w @bytebeacon/backend",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"./**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"./**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "migrate": "node apps/backend/dist/infrastructure/database/cli.js",
    "verify": "node scripts/verify-foundation.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
