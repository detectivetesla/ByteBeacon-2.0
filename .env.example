# ByteBeacon 2.0 Environment Configuration Template
# COPY TO .env (DO NOT COMMIT ACTUAL SECRETS TO GIT)

# 1. Environment & Server
NODE_ENV=development
PORT=3000
APP_VERSION=2.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_STOREFRONT_BASE_URL=https://apisolutions.store/store
VITE_PUBLIC_STOREFRONT_BASE_URL=https://apisolutions.store/store


# 2. Supabase / PostgreSQL Database Connection Pooler
# Production: Use Supabase Transaction Pooler (port 6543) or Session Pooler (port 5432) with ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bytebeacon_dev
DB_SSL=false

# 3. Managed Redis (BullMQ Queues, Locks, Idempotency & Rate Limiting)
REDIS_URL=redis://localhost:6379

# 4. Security & Cryptography
# Must be at least 32 characters for cryptographic HMAC-SHA256 signing
JWT_SECRET=your-32-plus-character-secret-key-here-minimum-length
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# 5. External Provider: Paystack Gateway (Live / Test)
PAYSTACK_SECRET_KEY=sk_test_placeholder_key_here
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key_here

# 6. External Provider: DataHouse Telecom Gateway (Sandbox / Live)
DATAHOUSE_BASE_URL=https://sandbox.getmorepaylessdatahouse.net/api/v1
DATAHOUSE_API_KEY=dh_sandbox_placeholder_key
DATAHOUSE_WEBHOOK_SECRET=dh_webhook_placeholder_secret

# 7. Sentry Error & Performance Observability
SENTRY_DSN=

# 8. Feature Flags & Kill-Switches
FF_NEW_ORDER_ENGINE=true
FF_AGENT_STORES=true
FF_MTN_PRECHECK=true
FF_PAYSTACK_LIVE=false
FF_MAINTENANCE_MODE=false
FF_DEVELOPER_SANDBOX=true

# 9. Provider Testing Flags (MUST BE FALSE IN PRODUCTION)
ALLOW_MOCK_PROVIDERS=true

# 10. Temporary Local Development Seed Accounts (DO NOT ENABLE IN PRODUCTION)
DEV_AUTH_ENABLED=false
